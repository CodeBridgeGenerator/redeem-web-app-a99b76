# Backend environment example (copy to .env and fill values)

# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017/redeem-web-app

# App metadata
PROJECT_NAME=redeem-web-app
PROJECT_LABEL='Redeem-Web-App'
ENV=development
LAST_UPDATED='YYYY-MM-DD'

# Auth/JWT
AUTH_SECRET=change_me

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_ENCRYPTION=tls
MAIL_NO_REPLY_ALIAS=no-reply@example.com

# AWS S3 (if using S3 uploads)
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_access_key_id
S3_ACCESS_SECRET=your_aws_secret_access_key
S3=https://your-bucket.s3.amazonaws.com/your/prefix/

# Optional: Redis (uncomment and set if needed)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

